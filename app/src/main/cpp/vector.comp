#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float values[]; } inputData;
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float values[]; } outputData;
layout(push_constant) uniform Parameters { uint count; } params;
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < params.count)
        outputData.values[index] = inputData.values[index] * 2.0 + 1.0;
}
